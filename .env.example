# PostgreSQL
DATABASE_URL=postgresql://genea:genea@localhost:5432/genealogy

# OpenAI (legacy per-cell OCR fallback)
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-4o

# Yandex Vision OCR (recommended for metric books)
# https://aistudio.yandex.ru/docs/ru/vision/concepts/ocr/
YANDEX_IAM_TOKEN=
YANDEX_FOLDER_ID=
METRIC_OCR_ENGINE=yandex
YANDEX_OCR_MODEL=table
YANDEX_HEADER_MODEL=page
YANDEX_CELL_MODEL=handwritten
